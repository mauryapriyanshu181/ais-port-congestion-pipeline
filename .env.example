# Copy to .env; docker compose reads it automatically.

# mock = simulated ships, no key needed; live = real AIS data from aisstream.io
PRODUCER_MODE=mock

# Free API key from https://aisstream.io (only needed for live mode)
AISSTREAM_API_KEY=

# Optional: limit live data to areas instead of the whole world.
# Format: [[[lat_min, lon_min], [lat_max, lon_max]], ...]  e.g. around Singapore:
# BOUNDING_BOXES=[[[0.8,103.3],[1.8,104.5]]]

# Congestion time buckets. Anchored ships report only every 3 minutes, so keep
# the window well above that. Changing these later: stop the stack and delete
# data/lake/gold and data/checkpoints/gold_port_congestion first.
CONGESTION_WINDOW=15 minutes
# How long to wait for late messages before a window is final
CONGESTION_WATERMARK=5 minutes
